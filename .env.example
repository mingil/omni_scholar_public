# ==============================================================================
# 🌍 OmniScholar Environment Configuration (.env.example)
# Copy this file to `.env` before running Docker:
#   cp .env.example .env
# ==============================================================================

# 1. OpenAlex API Settings (Recommended for Polite Pool — faster & stable API responses)
OPENALEX_EMAIL="your_email@university.edu"
OPENALEX_API_KEY=""

# 2. Optional Web Portal Password Lock
# - Set a password (e.g., APP_PASSWORD="my_secret_password") to require login.
# - Leave empty (APP_PASSWORD="") to allow immediate access without a login screen.
APP_PASSWORD=""

# 3. Docker Container Port & User Permissions (Optional overrides for compose.yaml)
APP_PORT=18502
PUID=1000
PGID=1000

# 4. Cloudflare Tunnel Token (Optional — used by compose.cloudflare.yaml for instant external domain access)
CF_TUNNEL_TOKEN=""

# 5. Cloudflare WAF Rate-Limiting Automation (Optional — used by setup_waf.py)
CF_ZONE_ID=""
CF_API_TOKEN=""
CF_DOMAIN="scholar.yourdomain.com"
